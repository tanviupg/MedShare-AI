APP_NAME=MedShare AI API
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
# DATABASE_URL format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
# JWT_SECRET: generate a long random value for local deployments
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
EXPIRY_WARNING_DAYS=90
MEDICINE_EXTRACTION_PROVIDER=gemini
# GEMINI_API_KEY: provide a key from your configured extraction provider
GEMINI_API_KEY=replace-with-your-provider-api-key
GEMINI_MODEL=gemini-2.5-flash
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
